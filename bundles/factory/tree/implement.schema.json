{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "gate",
    "reason",
    "title",
    "brief",
    "questions",
    "findings",
    "deferred",
    "outbound",
    "orchestrator",
    "add_ons",
    "follow_ups"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "escalated",
        "needs-input",
        "rescope",
        "failed",
        "awaiting-approval"
      ]
    },
    "gate": {
      "description": "The production gate (G1, G2, ...) an execution stopped before, for awaiting-approval; empty otherwise",
      "type": "string",
      "maxLength": 3
    },
    "reason": {
      "description": "Why, for escalated, needs-input, rescope and failed, in 1-2 sentences; empty for done. Posted for CD: plain language per ops/sdlc/process/writing-for-cd.md.",
      "type": "string",
      "maxLength": 600
    },
    "title": {
      "description": "PR title, at most 72 characters; empty for needs-input, rescope and failed",
      "type": "string",
      "maxLength": 72
    },
    "brief": {
      "description": "The PR description, one field per section of ops/sdlc/templates/pr_description_template.md (code variant). Plain sentences, no markdown except backticks around a path or code name; about 500 words in all. Empty fields when stopping without a PR",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "user_changes",
        "decisions",
        "deviations",
        "scope",
        "scope_integrity",
        "risk",
        "review_focus",
        "verification",
        "how_it_works",
        "files",
        "concepts"
      ],
      "properties": {
        "problem": {
          "description": "The problem: what prompted this and the symptom a user sees, in 2-3 plain sentences",
          "type": "string",
          "maxLength": 400
        },
        "user_changes": {
          "description": "Each change a user will see, in their terms; empty when nothing is visible",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 4
        },
        "decisions": {
          "description": "What CD approves by merging: the behavior being merged; a rejected alternative only where one was weighed",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choice",
              "rejected"
            ],
            "properties": {
              "choice": {
                "description": "The decision, as a short sentence",
                "type": "string",
                "maxLength": 200
              },
              "rejected": {
                "description": "The alternative not taken and why, written to follow the words Rather than",
                "type": "string",
                "maxLength": 160
              }
            }
          }
        },
        "deviations": {
          "description": "Deviations from the approved plan and why; empty for none or for a direct fix",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 4
        },
        "scope": {
          "description": "What is tackled, what is not (non-goals), and follow-ups proposed as issues",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tackled",
            "not_tackled",
            "deferred"
          ],
          "properties": {
            "tackled": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 160
              },
              "maxItems": 4
            },
            "not_tackled": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 160
              },
              "maxItems": 4
            },
            "deferred": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "maxItems": 4
            }
          }
        },
        "scope_integrity": {
          "description": "No tests or CI checks weakened and only the planned files touched, or each exception with its reason",
          "type": "string",
          "maxLength": 300
        },
        "risk": {
          "description": "Tier by the template risk table (empty only when stopping early), why, the top risks, and how to undo",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "why",
            "items",
            "undo"
          ],
          "properties": {
            "tier": {
              "type": "string",
              "enum": [
                "",
                "low",
                "medium",
                "high"
              ]
            },
            "why": {
              "type": "string",
              "maxLength": 200
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "maxItems": 3
            },
            "undo": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "review_focus": {
          "description": "Where the author is least sure, and what CD may not have thought of",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 4
        },
        "verification": {
          "description": "How it was verified: commands and outcomes, test counts, and any check that could not run",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          },
          "maxItems": 5
        },
        "how_it_works": {
          "description": "The approach at a high level, how the pieces fit, and why it is shaped this way when not obvious",
          "type": "string",
          "maxLength": 500
        },
        "files": {
          "description": "Key files in reading order, each with its role in this change",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role"
            ],
            "properties": {
              "path": {
                "description": "Repository path, read before naming it",
                "type": "string",
                "maxLength": 160
              },
              "role": {
                "description": "Its role in this change",
                "type": "string",
                "maxLength": 160
              }
            }
          }
        },
        "concepts": {
          "description": "0-3 terms CD may not know, each with a plain definition",
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "meaning"
            ],
            "properties": {
              "term": {
                "type": "string",
                "maxLength": 60
              },
              "meaning": {
                "description": "A plain definition",
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "questions": {
      "description": "1-3 entries when status is needs-input, empty otherwise. A question is the decision, why it matters, and each option with its consequence in one line, recommended first. Posted for CD: plain language per ops/sdlc/process/writing-for-cd.md.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2400
      },
      "maxItems": 3
    },
    "findings": {
      "description": "Open findings: critical/major when escalated, open minors otherwise",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "location",
          "summary"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "location": {
            "type": "string",
            "description": "Where: a file and line, or a document section",
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "description": "One line: what is wrong and why it matters. Posted for CD: plain language per ops/sdlc/process/writing-for-cd.md.",
            "maxLength": 400
          }
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      },
      "description": "Questions and follow-ups that did not block the run, one line each with its options. Posted for CD: plain language per ops/sdlc/process/writing-for-cd.md."
    },
    "outbound": {
      "description": "Skipped actions outside the working tree, for CD: one line each, what to do and where. Posted for CD: plain language per ops/sdlc/process/writing-for-cd.md.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_edits",
        "review_rounds",
        "agents"
      ],
      "properties": {
        "self_edits": {
          "type": "integer",
          "minimum": 0
        },
        "review_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "add_ons": {
      "description": "Small fixes done in this PR beyond the plan or issue: no new decision, inside the area touched, verified like planned work",
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "why",
          "paths",
          "verified"
        ],
        "properties": {
          "what": {
            "type": "string",
            "maxLength": 160
          },
          "why": {
            "type": "string",
            "maxLength": 160
          },
          "paths": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "verified": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "follow_ups": {
      "description": "Work for later, one issue each: on an executed plan the checked ones are filed when CD merges; ids F1 to F10 in order",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "why_not_now"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 3
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "maxLength": 300
          },
          "why_not_now": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    }
  }
}
