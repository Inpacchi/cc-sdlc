#!/usr/bin/env bash
# python-node profile: the project's checks, for agents in the Bash sandbox. The factory's skills run
# this instead of naming the project's commands (they are `make verify`'s direct equivalents; make
# needs docker compose, which agent jobs don't have). Installed read-only at /opt/factory by
# agent_job.sh workspace, beside verify.conf (python=<dir>, node=<dir>, from factory.json's stack).
# Usage: verify [--print] [python|node|probe ...]
#   no area      python and node
#   python       the test suite, through with-test-services (it reaches the test database and Redis)
#   node         lint, type check and production build
#   probe        what an agent job needs works here: the test database through the project's own
#                settings, and the Node toolchain (factory-smoke's implement-tools probe); prints
#                probe-ok when both do
#   --print      print the commands and run nothing (to run a narrower one, such as a single test)
# Runs every area asked for, even after one fails, and exits 1 if any did.
set -uo pipefail

here=$(cd "$(dirname "$0")" && pwd)
python_dir=$(sed -n 's/^python=//p' "$here/verify.conf")
node_dir=$(sed -n 's/^node=//p' "$here/verify.conf")
[ -n "$python_dir" ] && [ -n "$node_dir" ] || { echo "verify: no python or node directory in $here/verify.conf" >&2; exit 2; }
wrap=$here/with-test-services

print=no
areas=()
for a in "$@"; do
  case "$a" in
    --print) print=yes ;;
    python|node|probe) areas+=("$a") ;;
    *) echo "verify: unknown area $a (python, node, probe)" >&2; exit 2 ;;
  esac
done
[ ${#areas[@]} -gt 0 ] || areas=(python node)

command_for() {
  case "$1" in
    python) echo "$wrap bash -c 'cd $python_dir && python -m pytest -q'" ;;
    node) echo "cd $node_dir && npx --no-install eslint . && npx --no-install tsc -b && npx --no-install vite build" ;;
    probe) echo "$wrap bash -c 'cd $python_dir && python manage.py migrate --plan > /dev/null && echo db-ok' && (cd $node_dir && npx --no-install tsc --version) && echo probe-ok" ;;
  esac
}

failed=()
for area in "${areas[@]}"; do
  cmd=$(command_for "$area")
  if [ "$print" = yes ]; then echo "$area: $cmd"; continue; fi
  echo "== verify $area: $cmd"
  bash -c "$cmd" || failed+=("$area")
done
if [ ${#failed[@]} -gt 0 ]; then
  echo "verify: failed: ${failed[*]}"
  exit 1
fi
[ "$print" = yes ] || echo "verify: passed: ${areas[*]}"
